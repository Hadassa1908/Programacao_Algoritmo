Algoritmo "ParOuImpar"

Var
   num: inteiro

Inicio
escreval("Olá!")
escreva ("Entre com o número: ")
        leia(num)
se (num%2=0) entao
   escreva("É um número par, seu tonhão, obrigada por utilizar nosso programa!!!")
   senao
   escreva ("É um número impar, seu tonhão, obrigada por utilizar nosso programa!!!")
   fimse
   
Fimalgoritmo